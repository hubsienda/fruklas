---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  const pages = [
    { slug: 'compradores', title: 'Compradores', intro: 'Productos y servicios para compradores profesionales.' },
    { slug: 'productores', title: 'Productores', intro: 'Para productores interesados en presentar su oferta y establecer contacto comercial.' },
    { slug: 'servicios', title: 'Servicios', intro: 'Servicios de FRUKLAS para el mercado profesional.' },
    { slug: 'calidad', title: 'Calidad', intro: 'Información de calidad de FRUKLAS.' },
    { slug: 'empresa', title: 'Empresa', intro: 'FRUKLAS S.L., en Mercalicante, Alicante.' },
  ];

  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
---
<BaseLayout title={`${page.title} | FRUKLAS S.L.`} description={`${page.title} — FRUKLAS S.L., Alicante.`}>
  <section class="bg-fruklas-cream py-20 sm:py-24">
    <div class="mx-auto max-w-5xl px-5 lg:px-8">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-fruklas-orange">FRUKLAS S.L.</p>
      <h1 class="mt-4 text-4xl font-black leading-[1.15] tracking-[-0.03em] sm:text-5xl">{page.title}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-black/60">{page.intro}</p>
    </div>
  </section>
</BaseLayout>

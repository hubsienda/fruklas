---
import { productCategories } from '../data/home';
const iconColours = ['text-[#7B2D4F]', 'text-fruklas-light-green', 'text-fruklas-orange', 'text-fruklas-green'];
---
<section class="bg-fruklas-cream py-20 sm:py-24" aria-labelledby="productos-title">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-fruklas-orange">Producto fresco</p>
      <h2 id="productos-title" class="mt-3 text-3xl font-black leading-[1.15] tracking-[-0.025em] sm:text-4xl">Productos</h2>
      <p class="mt-4 text-base leading-7 text-black/65">Una estructura preparada para incorporar fotografías, variedades, campañas y formatos conforme se suministre el contenido definitivo.</p>
    </div>
    <div class="mt-10 grid gap-px overflow-hidden border border-black/10 bg-black/10 sm:grid-cols-2 lg:grid-cols-4">
      {productCategories.map((category, index) => (
        <a href={`/es/productos/#${category.slug}`} id={category.slug} class="group min-h-64 bg-white p-7 transition-colors hover:bg-fruklas-green hover:text-white">
          <div class:list={["flex h-16 w-16 items-center justify-center transition-colors group-hover:text-white", iconColours[index]]} aria-hidden="true">
            {category.slug === 'uva' && (
              <svg viewBox="0 0 64 64" class="h-16 w-16 fill-none stroke-current" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M31 12c2.5-5.5 7-8 13-8M32 12c-5-2-9-1-13 2" />
                <path d="M37 8c4 3 5 7 3 11" />
                <circle cx="26" cy="21" r="6" /><circle cx="38" cy="21" r="6" />
                <circle cx="20" cy="32" r="6" /><circle cx="32" cy="32" r="6" /><circle cx="44" cy="32" r="6" />
                <circle cx="26" cy="43" r="6" /><circle cx="38" cy="43" r="6" />
                <circle cx="32" cy="54" r="6" />
              </svg>
            )}
            {category.slug === 'alcachofa' && (
              <svg viewBox="0 0 64 64" class="h-16 w-16 fill-none stroke-current" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M32 6c-4 5-6 10-6 15-4-3-8-5-12-5 0 10 3 20 9 27 3 4 6 7 9 9 3-2 6-5 9-9 6-7 9-17 9-27-4 0-8 2-12 5 0-5-2-10-6-15Z" />
                <path d="M26 20c0 7 2 13 6 18 4-5 6-11 6-18" />
                <path d="M17 23c2 7 7 13 15 18 8-5 13-11 15-18" />
                <path d="M20 34c3 6 7 10 12 13 5-3 9-7 12-13" />
                <path d="M32 47v12M27 59h10" />
              </svg>
            )}
            {category.slug === 'frutas' && (
              <svg viewBox="0 0 64 64" class="h-16 w-16 fill-none stroke-current" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M32 20c-5-7-13-7-18-2-7 7-4 24 4 34 4 5 9 7 14 3 5 4 10 2 14-3 8-10 11-27 4-34-5-5-13-5-18 2Z" />
                <path d="M32 20c0-8 4-13 11-16" />
                <path d="M34 10c6-2 11 0 14 5-6 2-11 0-14-5Z" />
              </svg>
            )}
            {category.slug === 'hortalizas' && (
              <svg viewBox="0 0 64 64" class="h-16 w-16 fill-none stroke-current" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M31 55C17 47 11 34 15 17c15 2 24 11 23 27" />
                <path d="M31 55c7-15 15-27 26-37 2 17-5 31-26 37Z" />
                <path d="M29 51c-1-13-4-23-9-30M34 48c6-10 12-18 19-24" />
                <path d="M31 55v5" />
              </svg>
            )}
          </div>
          <span class="mt-5 block text-xs font-black text-fruklas-orange group-hover:text-white/70">0{index + 1}</span>
          <h3 class="mt-2 text-2xl font-black leading-tight tracking-[-0.025em]">{category.name}</h3>
          <p class="mt-3 text-sm leading-6 text-black/55 group-hover:text-white/75">{category.note}</p>
          <span class="mt-5 inline-block font-bold" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</section>

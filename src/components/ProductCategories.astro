---
import { productCategories } from '../data/home';
---
<section class="bg-fruklas-cream py-20 sm:py-24" aria-labelledby="productos-title">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-fruklas-orange">Producto fresco</p>
      <h2 id="productos-title" class="mt-3 text-4xl font-black tracking-[-0.03em] sm:text-5xl">Productos</h2>
      <p class="mt-4 text-base leading-7 text-black/65">Una estructura preparada para incorporar fotografías, variedades, campañas y formatos conforme se suministre el contenido definitivo.</p>
    </div>
    <div class="mt-10 grid gap-px overflow-hidden border border-black/10 bg-black/10 sm:grid-cols-2 lg:grid-cols-4">
      {productCategories.map((category, index) => (
        <a href={`/es/productos/#${category.slug}`} id={category.slug} class="group min-h-64 bg-white p-7 transition-colors hover:bg-fruklas-green hover:text-white">
          <span class="text-sm font-black text-fruklas-orange group-hover:text-white/70">0{index + 1}</span>
          <h3 class="mt-16 text-3xl font-black tracking-[-0.03em]">{category.name}</h3>
          <p class="mt-3 text-sm leading-6 text-black/55 group-hover:text-white/75">{category.note}</p>
          <span class="mt-6 inline-block font-bold" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</section>

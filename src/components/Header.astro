---
import { locales, navigation } from '../data/site';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const headerClass = overlay
  ? 'absolute inset-x-0 top-0 z-50 border-b border-white/20 bg-black/15 text-white backdrop-blur-sm'
  : 'relative z-50 border-b border-black/10 bg-white text-fruklas-ink';
---
<header class={headerClass}>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-5 px-5 py-4 lg:px-8">
    <a href="/es/" class="shrink-0" aria-label="FRUKLAS, inicio">
      <img src="/logos/logo.png" alt="FRUKLAS" width="180" height="60" class:list={["h-11 w-auto", overlay && "brightness-0 invert"]} />
    </a>
    <nav class="hidden items-center gap-5 xl:flex" aria-label="Navegación principal">
      {navigation.map((item) => <a href={item.href} class="text-sm font-semibold transition-opacity hover:opacity-70">{item.label}</a>)}
    </nav>
    <div class="hidden items-center gap-3 md:flex">
      <details class="relative">
        <summary class="cursor-pointer list-none rounded-md px-3 py-2 text-sm font-semibold hover:bg-black/5">ES <span aria-hidden="true">▾</span></summary>
        <div class="absolute right-0 mt-2 w-48 border border-black/10 bg-white p-2 text-fruklas-ink shadow-xl">
          {locales.map((locale) => locale.available ? (
            <a href={`/${locale.code}/`} class="flex justify-between px-3 py-2 text-sm font-semibold hover:bg-fruklas-cream"><span>{locale.name}</span><span>{locale.label}</span></a>
          ) : (
            <span class="flex justify-between px-3 py-2 text-sm text-black/45" aria-disabled="true"><span>{locale.name}</span><span>{locale.label}</span></span>
          ))}
        </div>
      </details>
      <a href="/es/contacto/" class="bg-fruklas-orange px-4 py-2.5 text-sm font-bold text-white transition-opacity hover:opacity-90">Contactar</a>
    </div>
    <details class="relative md:hidden">
      <summary class="cursor-pointer list-none border border-current/30 px-3 py-2 text-sm font-bold">Menú</summary>
      <div class="absolute right-0 mt-3 w-[min(88vw,22rem)] border border-black/10 bg-white p-4 text-fruklas-ink shadow-2xl">
        <nav class="grid gap-1" aria-label="Navegación móvil">
          {navigation.map((item) => <a href={item.href} class="border-b border-black/8 px-2 py-3 font-semibold">{item.label}</a>)}
        </nav>
        <div class="mt-4 flex flex-wrap gap-2" aria-label="Idiomas">
          {locales.map((locale) => locale.available ? (
            <a href={`/${locale.code}/`} class="border border-fruklas-green px-3 py-2 text-sm font-bold text-fruklas-green">{locale.label}</a>
          ) : (
            <span class="border border-black/10 px-3 py-2 text-sm text-black/35" aria-disabled="true">{locale.label}</span>
          ))}
        </div>
        <a href="/es/contacto/" class="mt-4 block bg-fruklas-orange px-4 py-3 text-center font-bold text-white">Contactar</a>
      </div>
    </details>
  </div>
</header>

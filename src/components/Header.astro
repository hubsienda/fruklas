---
import { locales, navigation } from '../data/site';
import { commercialForms, getForeignNavigation, getInternationalConfig, isForeignLang } from '../data/i18n';

interface Props { overlay?: boolean; lang?: string }
const { overlay = false, lang = 'es' } = Astro.props;
const foreign = isForeignLang(lang);
const config = getInternationalConfig(lang);
const currentCode = foreign ? lang.toUpperCase() : 'ES';
const headerNavigation = foreign ? getForeignNavigation(lang) : navigation;
const homeHref = foreign ? `/${lang}/` : '/es/';
const navAria = config?.ui.navAria ?? 'Navegación principal';
const mobileNavAria = config?.ui.mobileNavAria ?? 'Navegación móvil';
const languagesAria = config?.ui.languagesAria ?? 'Idiomas';
const menuLabel = config?.ui.menuLabel ?? 'Menú';
const logoLabel = config?.ui.logoLabel ?? 'FRUKLAS, inicio';
const ctaLabel = config?.ui.enquiryCta ?? 'Contactar';
const ctaHref = foreign ? commercialForms[lang] : '/es/contacto/';
const headerClass = overlay
  ? 'absolute inset-x-0 top-0 z-50 border-b border-white/20 bg-black/15 text-white backdrop-blur-sm'
  : 'relative z-50 border-b border-black/10 bg-white text-fruklas-ink';
---
<header class={headerClass}>
  <div class="relative mx-auto flex max-w-7xl items-center justify-between gap-3 px-5 py-3.5 lg:px-6 xl:px-8">
    <a href={homeHref} class="shrink-0" aria-label={logoLabel}>
      <img src="/logos/logo.png" alt="FRUKLAS" width="180" height="60" class="h-10 w-auto sm:h-11" />
    </a>

    <nav class="hidden items-center gap-2 lg:flex xl:gap-4" aria-label={navAria}>
      {headerNavigation.map((item) => (
        <a href={item.href} class="rounded-sm px-1 py-2 text-[13px] font-semibold transition-opacity hover:opacity-70 xl:text-sm">{item.label}</a>
      ))}
    </nav>

    <div class="hidden shrink-0 items-center gap-2 lg:flex xl:gap-3">
      <details class="group relative" data-fruklas-menu>
        <summary class="cursor-pointer list-none rounded-md px-2 py-2 text-[13px] font-semibold hover:bg-black/5 xl:px-3 xl:text-sm">
          {currentCode} <span aria-hidden="true" class="inline-block transition-transform group-open:rotate-180">▾</span>
        </summary>
        <div class="absolute right-0 top-full mt-2 w-48 border border-black/10 bg-white p-2 text-fruklas-ink shadow-xl">
          {locales.map((locale) => (
            <a
              href={`/${locale.code}/`}
              aria-current={locale.code === lang ? 'page' : undefined}
              class:list={[
                'flex justify-between px-3 py-2 text-sm font-semibold hover:bg-fruklas-cream focus:bg-fruklas-cream',
                locale.code === lang && 'bg-fruklas-cream text-fruklas-green',
              ]}
            ><span>{locale.name}</span><span>{locale.label}</span></a>
          ))}
        </div>
      </details>
      {foreign ? (
        <a href={ctaHref} target="_blank" rel="noopener noreferrer" class="bg-fruklas-orange px-3 py-2.5 text-xs font-bold uppercase tracking-[0.06em] text-white transition-opacity hover:opacity-90 xl:px-4 xl:text-sm">{ctaLabel}<span class="sr-only"> ({config?.ui.externalNote})</span></a>
      ) : (
        <a href={ctaHref} class="bg-fruklas-orange px-3 py-2.5 text-xs font-bold uppercase tracking-[0.06em] text-white transition-opacity hover:opacity-90 xl:px-4 xl:text-sm">{ctaLabel}</a>
      )}
    </div>

    <details class="group relative lg:hidden" data-fruklas-menu data-mobile-menu>
      <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-sm border border-current/35" aria-label={menuLabel}>
        <span class="sr-only">{menuLabel}</span>
        <span class="relative block h-5 w-6" aria-hidden="true">
          <span class="absolute left-0 top-0.5 h-0.5 w-6 bg-current transition-all group-open:top-2.5 group-open:rotate-45"></span>
          <span class="absolute left-0 top-2.5 h-0.5 w-6 bg-current transition-opacity group-open:opacity-0"></span>
          <span class="absolute left-0 top-[1.125rem] h-0.5 w-6 bg-current transition-all group-open:top-2.5 group-open:-rotate-45"></span>
        </span>
      </summary>
      <div class="absolute right-0 top-full mt-3 max-h-[calc(100svh-6rem)] w-[min(90vw,22rem)] overflow-y-auto border border-black/10 bg-white p-4 text-fruklas-ink shadow-2xl">
        <nav class="grid gap-1" aria-label={mobileNavAria}>
          {headerNavigation.map((item) => <a href={item.href} class="border-b border-black/10 px-2 py-3 text-base font-semibold hover:bg-fruklas-cream focus:bg-fruklas-cream">{item.label}</a>)}
        </nav>
        <div class="mt-4 flex flex-wrap gap-2" aria-label={languagesAria}>
          {locales.map((locale) => (
            <a
              href={`/${locale.code}/`}
              aria-current={locale.code === lang ? 'page' : undefined}
              class:list={[
                'border px-3 py-2 text-sm font-bold',
                locale.code === lang ? 'border-fruklas-orange bg-fruklas-cream text-fruklas-green' : 'border-fruklas-green text-fruklas-green',
              ]}
            >{locale.label}</a>
          ))}
        </div>
        {foreign ? (
          <a href={ctaHref} target="_blank" rel="noopener noreferrer" class="mt-4 block bg-fruklas-orange px-4 py-3 text-center font-bold uppercase tracking-[0.06em] text-white">{ctaLabel}<span class="sr-only"> ({config?.ui.externalNote})</span></a>
        ) : (
          <a href={ctaHref} class="mt-4 block bg-fruklas-orange px-4 py-3 text-center font-bold uppercase tracking-[0.06em] text-white">{ctaLabel}</a>
        )}
      </div>
    </details>
  </div>
</header>

<script is:inline>
  (() => {
    const menus = Array.from(document.querySelectorAll('[data-fruklas-menu]'));

    const closeOtherMenus = (current) => {
      menus.forEach((menu) => {
        if (menu !== current) menu.removeAttribute('open');
      });
    };

    menus.forEach((menu) => {
      menu.addEventListener('toggle', () => {
        if (menu.hasAttribute('open')) closeOtherMenus(menu);
      });
      menu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => menu.removeAttribute('open'));
      });
    });

    document.addEventListener('click', (event) => {
      menus.forEach((menu) => {
        if (menu.hasAttribute('open') && !menu.contains(event.target)) menu.removeAttribute('open');
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const openMenu = menus.find((menu) => menu.hasAttribute('open'));
      if (!openMenu) return;
      openMenu.removeAttribute('open');
      openMenu.querySelector('summary')?.focus();
    });
  })();
</script>

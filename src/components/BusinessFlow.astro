---
import { coreAreas } from '../data/home';
---
<section class="bg-white py-16 sm:py-20 lg:py-24" aria-labelledby="actividad-title">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.4fr] lg:gap-16">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.16em] text-fruklas-light-green">Qué hacemos</p>
        <h2 id="actividad-title" class="mt-3 text-3xl font-bold leading-[1.2] tracking-[-0.025em] sm:text-4xl">Del producto al mercado.</h2>
      </div>
      <div class="grid gap-8 sm:grid-cols-3">
        {coreAreas.map((area) => (
          <article class="border-t-2 border-fruklas-green pt-5">
            <h3 class="text-xl font-bold leading-snug">{area.title}</h3>
            <p class="mt-3 text-base leading-7 text-fruklas-black">{area.text}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

---
import { company } from '../data/site';
---
<section class="bg-fruklas-ink py-16 text-white sm:py-20 lg:py-24" aria-labelledby="contacto-title">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 lg:grid-cols-[1fr_0.9fr] lg:gap-16 lg:px-8">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-fruklas-orange">Contacto</p>
      <h2 id="contacto-title" class="mt-3 text-3xl font-bold leading-[1.2] tracking-[-0.025em] sm:text-4xl">Hablemos de producto.</h2>
      <p class="mt-5 max-w-xl text-lg leading-8 text-white">FRUKLAS está en Mercalicante, Alicante. Contacte directamente para consultas comerciales.</p>
      <a href="/es/contacto/" class="mt-7 inline-flex min-h-12 items-center justify-center bg-fruklas-orange px-5 py-3 font-bold text-white transition-opacity hover:opacity-90">Contactar con FRUKLAS</a>
    </div>
    <address class="not-italic border-t-2 border-fruklas-orange pt-6 text-base leading-7 text-white/90">
      <p class="text-xl font-bold text-white">{company.name}</p>
      {company.addressLines.map((line) => <p>{line}</p>)}
      <p class="mt-4"><strong>C.I.F.</strong> {company.cif}</p>
      <p><strong>Tel/Fax:</strong> <a href={company.phoneHref} class="font-semibold text-white underline decoration-fruklas-orange">{company.phone}</a></p>
      <p><strong>Móvil:</strong> <a href={company.mobileHref} class="font-semibold text-white underline decoration-fruklas-orange">{company.mobile}</a></p>
      <a href={company.mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-5 inline-block font-bold text-fruklas-orange underline">Abrir en Google Maps <span class="sr-only">(se abre en una nueva pestaña)</span></a>
    </address>
  </div>
</section>

---
import type { InternationalLocaleConfig } from '../data/i18n';
import { commercialForms, foreignRoutes, sharedInternationalResources } from '../data/i18n';

interface Props { config: InternationalLocaleConfig }
const { config } = Astro.props;
const routes = foreignRoutes[config.code];
const formUrl = commercialForms[config.code];
const ext = config.ui.externalNote;
---
<section class="relative min-h-[72svh] overflow-hidden bg-fruklas-ink text-white">
  <img src="/webpics/homehero.jpeg" alt="" class="absolute inset-0 h-full w-full object-cover" aria-hidden="true" />
  <div class="absolute inset-0 bg-black/48" aria-hidden="true"></div>
  <div class="relative mx-auto flex min-h-[72svh] max-w-7xl items-end px-5 pb-16 pt-36 sm:pb-20 lg:px-8 lg:pb-24">
    <div class="max-w-4xl">
      <p class="text-sm font-bold uppercase tracking-[0.18em] text-fruklas-orange">FRUKLAS · Compromiso Natural</p>
      <h1 class="mt-5 text-5xl font-bold leading-[1.02] tracking-[-0.045em] sm:text-6xl lg:text-7xl">{config.home.heroTitle}</h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-white sm:text-xl">{config.home.heroLead}</p>
      <a href={formUrl} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex min-h-12 items-center justify-center bg-fruklas-orange px-6 py-3 font-bold uppercase tracking-[0.05em] text-fruklas-ink transition-opacity hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
        {config.ui.enquiryCta}<span class="ml-2" aria-hidden="true">↗</span><span class="sr-only"> ({ext})</span>
      </a>
    </div>
  </div>
</section>

<section class="bg-white py-16 sm:py-20 lg:py-24">
  <div class="mx-auto grid max-w-7xl gap-8 px-5 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16 lg:px-8">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-fruklas-green">{config.home.introEyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold leading-[1.18] tracking-[-0.025em] text-fruklas-ink sm:text-4xl">{config.home.introTitle}</h2>
    </div>
    <p class="max-w-2xl text-lg leading-8 text-fruklas-black">{config.home.introBody}</p>
  </div>
</section>

<section class="bg-fruklas-cream py-16 sm:py-20 lg:py-24" aria-labelledby="international-products-title">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <p class="text-sm font-bold uppercase tracking-[0.16em] text-fruklas-orange">{config.home.productsEyebrow}</p>
    <div class="mt-3 grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
      <h2 id="international-products-title" class="text-3xl font-bold leading-[1.18] tracking-[-0.025em] text-fruklas-ink sm:text-4xl">{config.home.productsTitle}</h2>
      <p class="max-w-2xl text-lg leading-8 text-fruklas-black">{config.home.productsBody}</p>
    </div>
    <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <a href={routes.products} class="min-h-28 bg-fruklas-grape p-6 text-xl font-bold text-white transition-opacity hover:opacity-90">{config.home.productLabels.grapes}</a>
      <a href={routes.products} class="min-h-28 bg-fruklas-artichoke-deep p-6 text-xl font-bold text-white transition-opacity hover:opacity-90">{config.home.productLabels.artichokes}</a>
      <a href={routes.products} class="min-h-28 bg-fruklas-orange p-6 text-xl font-bold text-fruklas-ink transition-opacity hover:opacity-90">{config.home.productLabels.fruit}</a>
      <a href={routes.products} class="min-h-28 bg-fruklas-green p-6 text-xl font-bold text-white transition-opacity hover:opacity-90">{config.home.productLabels.vegetables}</a>
    </div>
  </div>
</section>

<section class="bg-white py-16 sm:py-20 lg:py-24">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:px-8">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-fruklas-green">{config.home.buyersEyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold leading-[1.18] text-fruklas-ink sm:text-4xl">{config.home.buyersTitle}</h2>
    </div>
    <div class="max-w-2xl">
      <p class="text-lg leading-8 text-fruklas-black">{config.home.buyersBody}</p>
      <a href={routes.buyers} class="mt-7 inline-flex min-h-12 items-center font-bold text-fruklas-green underline decoration-fruklas-orange decoration-2 underline-offset-4">{config.nav.buyers}</a>
    </div>
  </div>
</section>

<section class="bg-fruklas-warm-orange py-16 sm:py-20 lg:py-24">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:px-8">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-fruklas-orange">{config.home.docsEyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold leading-[1.18] text-fruklas-ink sm:text-4xl">{config.home.docsTitle}</h2>
    </div>
    <div class="max-w-2xl">
      <p class="text-lg leading-8 text-fruklas-black">{config.home.docsBody}</p>
      <a href={sharedInternationalResources.productDocumentation} target="_blank" rel="noopener noreferrer" class="mt-7 inline-flex min-h-12 items-center justify-center bg-fruklas-green px-6 py-3 font-bold uppercase tracking-[0.05em] text-white">{config.home.docsCta}<span class="ml-2" aria-hidden="true">↗</span><span class="sr-only"> ({ext})</span></a>
    </div>
  </div>
</section>

<section class="bg-fruklas-soft-green py-16 sm:py-20 lg:py-24">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-2 lg:px-8">
    <div class="border-t-4 border-fruklas-green pt-6">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-fruklas-green">{config.home.qualityEyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold text-fruklas-ink">{config.home.qualityTitle}</h2>
      <p class="mt-5 text-lg leading-8 text-fruklas-black">{config.home.qualityBody}</p>
      <a href={routes.quality} class="mt-6 inline-flex min-h-12 items-center font-bold text-fruklas-green underline decoration-2">{config.nav.quality}</a>
    </div>
    <div class="border-t-4 border-fruklas-orange pt-6">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-fruklas-orange">{config.home.logisticsEyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold text-fruklas-ink">{config.home.logisticsTitle}</h2>
      <p class="mt-5 text-lg leading-8 text-fruklas-black">{config.home.logisticsBody}</p>
      <a href={routes.logistics} class="mt-6 inline-flex min-h-12 items-center font-bold text-fruklas-green underline decoration-2">{config.nav.logistics}</a>
    </div>
  </div>
</section>

<section class="bg-white py-16 sm:py-20 lg:py-24">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:px-8">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-fruklas-light-green">{config.home.companyEyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold leading-[1.18] text-fruklas-ink sm:text-4xl">{config.home.companyTitle}</h2>
    </div>
    <div class="max-w-2xl">
      <p class="text-lg leading-8 text-fruklas-black">{config.home.companyBody}</p>
      <a href={routes.company} class="mt-6 inline-flex min-h-12 items-center font-bold text-fruklas-green underline decoration-2">{config.nav.company}</a>
    </div>
  </div>
</section>

<section class="bg-fruklas-ink py-16 text-white sm:py-20 lg:py-24">
  <div class="mx-auto grid max-w-7xl gap-8 px-5 lg:grid-cols-[0.9fr_1.1fr] lg:items-end lg:px-8">
    <div>
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-fruklas-orange">{config.home.ctaEyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold leading-[1.18] sm:text-4xl">{config.home.ctaTitle}</h2>
    </div>
    <div class="max-w-2xl">
      <p class="text-lg leading-8 text-white">{config.home.ctaBody}</p>
      <a href={formUrl} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex min-h-12 items-center justify-center bg-fruklas-orange px-6 py-3 font-bold uppercase tracking-[0.05em] text-fruklas-ink">{config.ui.enquiryCta}<span class="ml-2" aria-hidden="true">↗</span><span class="sr-only"> ({ext})</span></a>
    </div>
  </div>
</section>
